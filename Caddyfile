# Если домена пока нет, работаем по IP адресу сервера:
:80 {
    reverse_proxy web:8000
}

# Когда купите домен (например, geopulse.ru), просто раскомментируйте блок ниже
# и закомментируйте блок :80 выше. Caddy автоматически получит бесплатный SSL (HTTPS)!
#
# geopulse.ru {
#     reverse_proxy web:8000
# }
